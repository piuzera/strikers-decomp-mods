+static const unsigned int ExpandedReplayMemorySize = 0x800000;
+static const unsigned int ExpandedReplayMaxFrameSize = 0x20000;
+static unsigned int sReplayMemorySize = 0x1C0000;
+
+// Retail kept replays in ARAM-backed virtual memory. The expanded buffer is
+// main memory, so its size must respect whatever the loaded match leaves free:
+// a fixed 8 MB request traps in the allocator (nlBreak) and hangs loading when
+// the tenth team's assets are resident. Take the largest buffer that fits with
+// headroom for the loaders that run after replay initialization.
+static unsigned int ChooseReplayMemorySize()
+{
+    static const unsigned int candidates[] = {
+        ExpandedReplayMemorySize, 0x400000, 0x200000, 0x1C0000, 0x100000,
+    };
+    const unsigned int largest = StandardAllocator.LargestFreeBlock();
+    const unsigned int headroom = 0x140000;
+    unsigned int chosen = 0x100000;
+    for (unsigned int i = 0; i < sizeof(candidates) / sizeof(candidates[0]); i++)
+    {
+        if (candidates[i] <= largest && largest - candidates[i] >= headroom)
+        {
+            chosen = candidates[i];
+            break;
+        }
+    }
+    OSReport("EXPAND replay buffer: largest=%u chosen=%u\n", largest, chosen);
+    return chosen;
+}
