diff --git a/include/NL/StreamingBuffer.h b/include/NL/StreamingBuffer.h
new file mode 100644
index 00000000..66010677
--- /dev/null
+++ b/include/NL/StreamingBuffer.h
@@ -0,0 +1,19 @@
+#ifndef _NL_STREAMINGBUFFER_H_
+#define _NL_STREAMINGBUFFER_H_
+
+// A virtual-memory read is chunked; its transfer hint is not a file-size cap.
+// Bound temporary MRAM use even when a model requests a 512 KiB transfer, and
+// keep the allocation aligned for DVD reads. Zero-byte files need no scratch.
+inline unsigned int nlVirtualReadChunkSize(unsigned int requested, unsigned int fileSize)
+{
+    if (fileSize == 0)
+        return 0;
+    unsigned int chunk = requested == 0 ? 0x10000 : requested;
+    if (chunk > 0x10000)
+        chunk = 0x10000;
+    if (chunk > fileSize)
+        chunk = fileSize;
+    return (chunk + 0x1F) & ~0x1Fu;
+}
+
+#endif // _NL_STREAMINGBUFFER_H_
