diff --git a/include/Game/CharacterClass.h b/include/Game/CharacterClass.h
new file mode 100644
index 00000000..29df0b4f
--- /dev/null
+++ b/include/Game/CharacterClass.h
@@ -0,0 +1,71 @@
+#ifndef _CHARACTERCLASS_H_
+#define _CHARACTERCLASS_H_
+
+enum eCharacterClass
+{
+    CHARACTER_CLASS_INVALID = -1,
+    BIRDO = 0,
+    DAISY = 1,
+    DONKEYKONG = 2,
+    HAMMERBROS = 3,
+    KOOPA = 4,
+    LUIGI = 5,
+    MARIO = 6,
+    PEACH = 7,
+    TOAD = 8,
+    WALUIGI = 9,
+    WARIO = 10,
+    YOSHI = 11,
+    MYSTERY = 12,
+    // Retail table/goalkeeper boundary; new fielders need explicit mappings.
+    NUM_FIELDER_CLASSES = 13,
+    DAISY_GOALIE = 13,
+    DONKEYKONG_GOALIE = 14,
+    LUIGI_GOALIE = 15,
+    MARIO_GOALIE = 16,
+    PEACH_GOALIE = 17,
+    WALUIGI_GOALIE = 18,
+    WARIO_GOALIE = 19,
+    YOSHI_GOALIE = 20,
+    SUPERTEAM_GOALIE = 21,
+    BOWSER_CLASS = 22,
+    HUMAN = 23,
+    NUM_CHARACTER_CLASSES = 24,
+    NUM_GOALIE_CLASSES = 9,
+};
+
+inline bool IsGoalieClass(eCharacterClass cc)
+{
+    return cc >= DAISY_GOALIE && cc <= SUPERTEAM_GOALIE;
+}
+
+inline bool IsFielderClass(eCharacterClass cc)
+{
+    return (cc >= BIRDO && cc < NUM_FIELDER_CLASSES) || cc == HUMAN;
+}
+
+inline bool IsCaptainClass(eCharacterClass cc)
+{
+    switch (cc)
+    {
+    case DAISY:
+    case DONKEYKONG:
+    case LUIGI:
+    case MARIO:
+    case PEACH:
+    case WALUIGI:
+    case WARIO:
+    case YOSHI:
+    case MYSTERY:
+        return true;
+    default:
+        return false;
+    }
+}
+
+inline eCharacterClass GetNativeCharacterClass(eCharacterClass cc)
+{
+    return cc == HUMAN ? DAISY : cc;
+}
+
+#endif // _CHARACTERCLASS_H_
