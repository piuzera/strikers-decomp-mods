 static nlVector3 sharedMorphBuffer[0x1000];
 
+// Morph deltas are immutable model data. Retail copies them for every mesh;
+// 22 characters exhaust virtual storage and spill those copies into main RAM.
+// Retain one owned copy per source block until its last mesh is destroyed.
+struct SharedMorphDeltas
+{
+    const MorphDelta* source;
+    MorphDelta* data;
+    unsigned long size;
+    unsigned int references;
+    SharedMorphDeltas* next;
+};
+
+static SharedMorphDeltas* sharedMorphDeltas = NULL;
+
+static void ReleaseMorphDeltas(MorphDelta* data)
+{
+    if (data == NULL)
+        return;
+    SharedMorphDeltas** link = &sharedMorphDeltas;
+    while (*link != NULL)
+    {
+        SharedMorphDeltas* entry = *link;
+        if (entry->data == data)
+        {
+            if (--entry->references == 0)
+            {
+                *link = entry->next;
+                delete[] entry->data;
+                delete entry;
+            }
+            return;
+        }
+        link = &entry->next;
+    }
+    delete[] data;
+}
